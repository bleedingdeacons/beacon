{
    "name": "bleedingdeacons/beacon",
    "description": "Call-forwarding contracts, models, HTTP transport, capabilities and REST controller, shared by Tamar and Trusted. A Composer library, not a WordPress plugin.",
    "type": "library",
    "license": "MIT (Modified)",
    "authors": [
        {
            "name": "The Bleeding Deacons"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/wp-mocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "bleedingdeacons/wp-mocks": "^3.0",
        "mockery/mockery": "^1.4",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beacon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beacon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "test:coverage": "pest --coverage-html ./tests/coverage",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcs:fix": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "stan": "@phpstan",
        "analyse": "@phpstan",
        "check": [
            "@phpcs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
